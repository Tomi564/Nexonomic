---
/**
 * Botón izquierdo: siempre al formulario de contacto (reuniones).
 * Botón derecho: streaming en vivo (YouTube por defecto; sobreescribible).
 */
const streamsUrl =
  (typeof import.meta.env.PUBLIC_RADIO_STREAM_URL === 'string' &&
    import.meta.env.PUBLIC_RADIO_STREAM_URL.trim()) ||
  'https://www.youtube.com/@ExceLente_Radio/streams';

const title =
  (typeof import.meta.env.PUBLIC_RADIO_PROGRAM_TITLE === 'string' &&
    import.meta.env.PUBLIC_RADIO_PROGRAM_TITLE.trim()) ||
  'Nexonomic en la radio';

const bodyText =
  (typeof import.meta.env.PUBLIC_RADIO_PROGRAM_TAGLINE === 'string' &&
    import.meta.env.PUBLIC_RADIO_PROGRAM_TAGLINE.trim()) ||
  'Podés escucharnos todos los jueves de 17 a 18 hs. en «ExceLente: La Economía en Foco», el programa de radio de economía de la UCA.';
---

<section
  id="radio"
  aria-labelledby="radio-heading"
  class="relative py-20 md:py-28 bg-deep-bg scroll-mt-24 md:scroll-mt-28 min-h-[min(28rem,55vh)] flex flex-col justify-center"
>
  <div class="max-w-7xl mx-auto px-6 relative z-10 w-full">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-10 lg:gap-16">
      <div class="flex items-start gap-5 md:gap-6">
        <div
          class="flex-shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-2xl bg-white/[0.04] border border-white/10 flex items-center justify-center text-accent shadow-lg shadow-black/30"
          aria-hidden="true"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 md:w-9 md:h-9">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
          </svg>
        </div>
        <div class="min-w-0">
          <p class="font-sans text-accent tracking-wide uppercase text-[11px] sm:text-xs mb-3 font-bold leading-snug max-w-md">
            Radiofónicos en vivo
          </p>
          <h2 id="radio-heading" class="font-serif text-3xl md:text-4xl text-white mb-4 leading-tight">
            {title}
          </h2>
          <p class="text-gray-400 font-sans text-base md:text-lg leading-relaxed max-w-xl">
            {bodyText}
          </p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row flex-wrap gap-4 lg:justify-end lg:flex-shrink-0">
        <a
          href="/#contact"
          class="inline-flex items-center justify-center px-8 py-4 bg-action hover:bg-accent text-white font-sans font-bold text-sm rounded-full transition-all duration-300 shadow-lg shadow-action/25 text-center"
        >
          Contacto
        </a>
        <a
          href={streamsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-8 py-4 border border-white/20 hover:bg-white/5 text-white font-sans font-bold text-sm rounded-full transition-all duration-300 text-center"
        >
          Streaming
        </a>
      </div>
    </div>
  </div>
</section>
