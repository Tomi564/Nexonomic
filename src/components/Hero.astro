---
// src/components/Hero.astro — Mismo video de fondo en móvil y escritorio (muted + playsinline). Imagen estática solo si "menos movimiento".
const poster = '/assets/img/hero-poster.jpg';
---

<section id="hero" class="relative min-h-screen w-full overflow-hidden flex items-center justify-center bg-deep-bg">
  
  <div class="absolute inset-0 w-full h-full z-0">
    <!-- Video en todos los anchos (iOS/Safari: playsinline + muted obligatorio para autoplay) -->
    <div class="hero-video-wrap absolute inset-0">
      <video
        id="hero-video"
        class="h-full w-full object-cover opacity-50 md:opacity-40"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={poster}
      >
        <source src="/assets/video/hero.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Sin video: "menos movimiento" del sistema → poster estático -->
    <div class="hero-static-desk absolute inset-0 z-[1] hidden">
      <img
        src={poster}
        alt=""
        class="h-full w-full object-cover opacity-40"
        decoding="async"
      />
    </div>

    <div class="absolute inset-0 bg-gradient-to-b from-deep-bg/25 via-deep-bg/55 to-deep-bg z-10 pointer-events-none md:from-deep-bg/40 md:via-deep-bg/85 md:to-deep-bg"></div>
    <!-- Glow decorativo con gradientes (sin blur CSS: mucho más barato en compositing) -->
    <div class="hero-blobs absolute inset-0 z-[2] pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/4 -left-16 h-64 w-64 rounded-full bg-[radial-gradient(circle_at_center,rgba(25,27,164,0.28)_0%,transparent_70%)] md:-left-20 md:h-96 md:w-80 lg:w-96"></div>
      <div class="absolute bottom-1/4 -right-16 h-64 w-64 rounded-full bg-[radial-gradient(circle_at_center,rgba(60,194,162,0.18)_0%,transparent_70%)] md:-right-20 md:h-96 md:w-80 lg:w-96"></div>
    </div>
  </div>

  <div class="relative z-20 text-center px-6 max-w-4xl mx-auto mt-16">
    <p class="font-sans text-accent tracking-[0.3em] uppercase text-xs mb-6 animate-fade-in-up font-bold">
      Economía • Entrevistas • Protagonistas
    </p>
    
    <h1 class="font-serif text-4xl sm:text-5xl md:text-7xl text-white leading-[1.1] mb-8 animate-fade-in-up delay-100">
      La economía, <br/>
      <span class="text-accent italic font-light">explicada por quienes la hacen</span>
    </h1>
    
    <p class="font-sans text-lg md:text-xl text-gray-400 max-w-2xl mx-auto mb-12 leading-relaxed animate-fade-in-up delay-200">
      El espacio que conecta la teoría económica con la experiencia real de quienes toman decisiones.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 justify-center animate-fade-in-up delay-300">
      <a href="#about" class="px-10 py-4 bg-action hover:bg-accent text-white font-sans font-bold rounded-full transition-all duration-500 transform hover:-translate-y-1 shadow-lg shadow-action/20 motion-reduce:transform-none">
        Conocer el Proyecto
      </a>
      <a href="#blog" class="px-10 py-4 border border-white/20 hover:bg-white/5 text-white font-sans font-bold rounded-full transition-all duration-500">
        Leer Artículos
      </a>
    </div>
  </div>

  <a href="#about" class="absolute bottom-8 left-0 right-0 mx-auto w-fit z-20 flex flex-col items-center gap-2 text-gray-500 hover:text-accent transition-colors motion-reduce:animate-none md:animate-bounce" aria-label="Scroll hacia abajo">
    <span class="font-sans text-xs uppercase tracking-widest">Explorar</span>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
  </a>
</section>

<script>
  function setupHeroVideoObserver() {
    const section = document.getElementById('hero');
    const video = document.getElementById('hero-video') as HTMLVideoElement | null;
    if (!section || !video) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const playPromise = video.play();
            if (playPromise?.catch) playPromise.catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0 }
    );

    observer.observe(section);
  }

  setupHeroVideoObserver();
  document.addEventListener('astro:page-load', setupHeroVideoObserver);
</script>

<style>
  /* Sin video cuando el sistema pide menos movimiento (cualquier tamaño de pantalla) */
  @media (prefers-reduced-motion: reduce) {
    .hero-video-wrap { display: none !important; }
    .hero-blobs { display: none !important; }
    .hero-static-desk { display: block !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in-up {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 1s ease-out forwards;
    opacity: 0;
  }
  .delay-100 { animation-delay: 0.1s; }
  .delay-200 { animation-delay: 0.2s; }
  .delay-300 { animation-delay: 0.3s; }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

</style>
