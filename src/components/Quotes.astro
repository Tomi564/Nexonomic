---
import QuotesCarousel from './QuotesCarousel';
import { getCitas } from '../utils/citas';

const citas = getCitas();
const quotes = citas.map((c) => ({
  slug: c.slug,
  author: c.author,
  role: c.role,
  text: c.text,
}));
---

<section id="citas" class="py-24 bg-deep-bg relative overflow-hidden scroll-mt-24 md:scroll-mt-28">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-action/10 via-transparent to-transparent opacity-50 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="font-sans text-accent tracking-widest uppercase text-xs mb-2 font-bold">Ideas</h2>
      <h3 class="font-serif text-3xl md:text-4xl text-white">Voces que inspiran</h3>
    </div>
    <QuotesCarousel client:load quotes={quotes} />
  </div>
</section>
