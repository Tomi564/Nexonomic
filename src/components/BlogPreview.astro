---
// src/components/BlogPreview.astro
import ContentCard from './ContentCard.astro';
import { getNoticias, formatDate, normalizePublicUrl } from '../utils/noticias';

const noticias = await getNoticias();

const posts = noticias
  .sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''))
  .slice(0, 3)
  .map(n => {
    const author = (n.data.author ?? '').trim();
    const date = formatDate(n.data.date);
    return {
      title: n.data.title,
      category: n.data.category,
      meta: author ? `${author} · ${date}` : date,
      excerpt: n.data.excerpt,
      image:
        normalizePublicUrl(n.data.image) ||
        'https://images.unsplash.com/photo-1611974765270-ca1258634369?q=80&w=2064&auto=format&fit=crop',
      link: `/blog/${n.slug}`,
    };
  });
---

<section id="blog" class="py-16 md:py-20 bg-[#080a0c]">
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="flex justify-between items-end mb-10 border-b border-white/10 pb-6">
      <div>
        <h2 class="font-sans text-accent tracking-widest uppercase text-sm mb-2 font-semibold">
          Noticias y Actualidad
        </h2>
        <h3 class="font-serif text-3xl md:text-4xl text-white">
          Artículos y Ensayos
        </h3>
      </div>
      <a href="/blog" class="hidden md:flex items-center gap-2 text-gray-500 hover:text-white transition-colors text-sm font-sans">
        Ver todos los artículos
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {posts.map((post) => (
        <ContentCard
          title={post.title}
          image={post.image}
          href={post.link}
          category={post.category}
          meta={post.meta}
          excerpt={post.excerpt}
          titleAs="h4"
        />
      ))}
    </div>

  </div>
</section>
