---
// 1. SIEMPRE debe empezar con los tres guiones
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
}

const {
	title,
	description = "Un espacio de reflexión crítica donde la teoría económica se encuentra con los fundamentos filosóficos de nuestra sociedad.",
	ogImage = "/Nexonomic_Logo_K-03.jpg",
} = Astro.props;

const siteBase = Astro.site ?? new URL('https://nexonomic.com');
/** og:image debe ser URL absoluta en redes sociales */
function ogAbsolute(raw: string): string {
	if (raw.startsWith('http://') || raw.startsWith('https://')) return raw;
	const path = raw.startsWith('/') ? raw : `/${raw}`;
	return new URL(path, siteBase.origin).href;
}

const canonicalHref = new URL(Astro.url.pathname, siteBase.origin).href;
const ogImageHref = ogAbsolute(ogImage);
const faviconVersion = '20260506';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${faviconVersion}`} />
		<link rel="icon" type="image/png" sizes="32x32" href={`/favicon.png?v=${faviconVersion}`} />
		<link rel="icon" type="image/png" sizes="16x16" href={`/favicon.png?v=${faviconVersion}`} />
		<link rel="shortcut icon" href={`/favicon.png?v=${faviconVersion}`} />
		<link rel="apple-touch-icon" sizes="180x180" href={`/favicon.png?v=${faviconVersion}`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={canonicalHref} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalHref} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageHref} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageHref} />

		<ViewTransitions />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Lora:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
	</head>
	<body class="bg-deep-bg text-white font-sans antialiased selection:bg-accent selection:text-deep-bg">
		<Navbar />
		<slot />
		<Footer />
	</body>
</html>

<style is:global>
	html {
		background: #050708;
		scrollbar-width: thin;
		scrollbar-color: #1f2937 #050708;
	}

	/* Personalización de la barra de scroll (Webkit) */
	::-webkit-scrollbar {
		width: 10px;
	}

	::-webkit-scrollbar-track {
		background: #050708;
	}

	::-webkit-scrollbar-thumb {
		background: #1f2937; 
		border-radius: 5px;
		border: 2px solid #050708;
	}

	::-webkit-scrollbar-thumb:hover {
		background: #3cc2a2; /* Color Accent */
	}
</style>