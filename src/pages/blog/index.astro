---
import Layout from '../../layouts/Layout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getNoticias, formatDate, normalizePublicUrl } from '../../utils/noticias';

const noticias = await getNoticias();

const posts = noticias
  .sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''))
  .map(n => {
    const author = (n.data.author ?? '').trim();
    const date = formatDate(n.data.date);
    return {
      title: n.data.title,
      category: n.data.category,
      meta: author ? `${author} · ${date}` : date,
      excerpt: n.data.excerpt,
      image:
        normalizePublicUrl(n.data.image) ||
        'https://images.unsplash.com/photo-1611974765270-ca1258634369?q=80&w=2064&auto=format&fit=crop',
      link: `/blog/${n.slug}`,
    };
  });
---

<Layout title="Artículos | Nexonomic">
  <header class="pt-28 md:pt-40 pb-12 md:pb-16 bg-deep-bg border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6">
      <p class="font-sans text-accent tracking-widest uppercase text-xs mb-4 font-bold">Archivo</p>
      <h1 class="font-serif text-4xl md:text-5xl text-white">Artículos y Ensayos</h1>
    </div>
  </header>

  <main class="bg-deep-bg min-h-screen py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-6">

      {posts.length === 0 ? (
        <p class="text-gray-500 font-sans text-center py-20">No hay artículos publicados aún.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <ContentCard
              title={post.title}
              image={post.image}
              href={post.link}
              category={post.category}
              meta={post.meta}
              excerpt={post.excerpt}
              titleAs="h2"
            />
          ))}
        </div>
      )}

      <div class="mt-20 pt-8 border-t border-white/10">
        <a href="/" class="text-accent hover:text-white transition-colors font-sans text-sm">
          ← Volver al inicio
        </a>
      </div>

    </div>
  </main>
</Layout>
